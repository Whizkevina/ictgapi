# Fallback Configuration
# --------------------
# Optional: Set a fallback YouTube stream URL to use when the API has issues
# Example: REACT_APP_FALLBACK_STREAM_URL="https://www.youtube.com/watch?v=YOUR_VIDEO_ID"
# REACT_APP_FALLBACK_STREAM_URL=""

# Development Settings
# ------------------
# Set to true to enable detailed YouTube API debug logs
REACT_APP_DEBUG_YOUTUBE_API=false

# Feature Flags
# ------------
# Enable/disable YouTube integration (set to false to bypass YouTube API completely)
REACT_APP_ENABLE_YOUTUBE=true