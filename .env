REACT_APP_UPDATE_LIVESTREAM_ENDPOINT=/Dashboard/UpdateAppSetting
REACT_APP_POLLING_INTERVAL=30000

# Admin Settings
# -------------
REACT_APP_ADMIN_PASSWORD="ictgadmin"

